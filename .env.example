# StudyApp Environment Variables Configuration
# Mật khẩu duy nhất để đăng nhập ứng dụng (Mặc định: studyapp123)
APP_PASSWORD=studyapp123

# Google Gemini API Key (Miễn phí 100% tại https://aistudio.google.com)
# Dùng để sinh mục lục và tạo bộ câu hỏi trắc nghiệm tự động từ file tài liệu
GEMINI_API_KEY=your_gemini_api_key_here

# Múi giờ ứng dụng (Mặc định: Asia/Ho_Chi_Minh để tính chuỗi Streak lúc nửa đêm)
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Cấu hình Database (Nếu dùng PostgreSQL Neon.tech hoặc Supabase miễn phí)
# Để trống nếu muốn dùng bộ lưu trữ file H2 tự động
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
